# =====================================================================
# Netlify cache-control headers for InHome
# Place this file (named exactly "_headers", no extension) at the REPO
# ROOT — same level as index.html. Netlify reads it on deploy.
#
# Goal: scouts on phones always get the newest HTML the moment you push,
# while images, fonts, and scripts still cache for speed.
# =====================================================================

# --- HTML pages: never serve a stale copy ---
# must-revalidate + max-age=0 means the browser checks with the server
# every load. If nothing changed, the server says "not modified" and it's
# still fast — but a new deploy shows up immediately, no hard refresh.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root and any clean URLs (e.g. yoursite.com/ or /scout-home)
/
  Cache-Control: public, max-age=0, must-revalidate

# --- Netlify functions: never cache API responses ---
# Reports, targets, scouts, etc. must always be live.
/.netlify/functions/*
  Cache-Control: no-store, max-age=0

# --- Static assets: cache hard for speed ---
# These rarely change, so let phones hold them for a year. When you DO
# change one, give it a new filename (logo-v2.png) so the browser fetches it.
#
# NOTE: your page scripts are currently embedded INSIDE the .html files,
# so they refresh with the HTML rule above — good. This .js rule only
# applies if you later split JavaScript into separate .js files loaded by
# the page. If you do that, rename the file whenever you change it
# (app-v2.js) or this year-long cache will keep serving the old one.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
